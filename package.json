{
  "name": "science-around-the-board",
  "version": "1.0.0",
  "description": "A browser-only, property-trading board game for classroom review. Instructors write the questions in one spreadsheet file; student teams play in the browser.",
  "author": "Hans Ghezzi",
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://hghezzi.github.io/Science-Around-the-Board/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hghezzi/Science-Around-the-Board.git"
  },
  "bugs": {
    "url": "https://github.com/hghezzi/Science-Around-the-Board/issues"
  },
  "keywords": ["education", "game-based-learning", "review-game", "active-recall", "classroom", "quiz", "board-game", "pwa", "react"],
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/package-skill.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "validate-tsv": "node scripts/validate-tsv.mjs",
    "package-skill": "node scripts/package-skill.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "a11y": "node scripts/a11y-check.mjs",
    "guide": "vite build && node scripts/guide-screenshots.mjs && node scripts/build-guide.mjs",
    "smoke": "vite build && node scripts/smoke-test.mjs",
    "privacy": "vite build && node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@mui/material": "^7.3.5",
    "canvas-confetti": "^1.9.4",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.23.24",
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "marked": "^18.1.0",
    "peer": "^1.0.2",
    "playwright": "^1.56.1",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
